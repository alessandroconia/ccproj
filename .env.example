# Copy to .env.local for local dev. All values are public (anon/publishable key only, never service_role).
# If the Supabase values are unset, the app falls back to public/data/items.json.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional. Must start with https://. Defaults to https://www.paypal.com/it/home when empty.
VITE_CHECKOUT_URL=
